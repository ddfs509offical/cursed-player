{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursed player",
  "version": "0.1.0",
  "identifier": "com.example.musichub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "features": null,
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cursed player",
        "width": 1360,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 650,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
